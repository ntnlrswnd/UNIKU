<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logouniku"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UNIKU"
        tools:targetApi="31">
        <activity
            android:name=".ActivityNAV"
            android:exported="false" />
        <!-- Activity untuk Login -->
        <activity
            android:name=".ActivityLogin"
            android:exported="false" /> <!-- MainActivity dijadikan sebagai launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>

                <!-- Menjadikan MainActivity sebagai aktivitas utama -->
                <action android:name="android.intent.action.MAIN" />

                <!-- Menambahkan kategori sebagai launcher -->
                <category android:name="android.intent.category.LAUNCHER" />

                <!-- Menambahkan kategori untuk menangani tombol HOME -->
                <category android:name="android.intent.category.HOME" />

                <!-- Menandai aplikasi sebagai default -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>